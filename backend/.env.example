# Salin menjadi .env, lalu isi. File .env TIDAK BOLEH di-commit.
# Dibaca oleh docker-compose.yml untuk container "db" (MySQL) dan container "app" (backend).
# Buat password dan secret acak dengan:  openssl rand -hex 32

NODE_ENV=production
PORT=3000

# --- Untuk container MySQL. Hanya dipakai saat database pertama kali dibuat. ---
MYSQL_DATABASE=marketplace_digital
MYSQL_USER=mentoring
MYSQL_PASSWORD=ganti-dengan-password-acak

# --- Untuk backend. Nilainya harus SAMA dengan baris MYSQL_* di atas. ---
# DB_HOST=db: nama container MySQL di docker-compose.yml. Bukan localhost.
DB_HOST=db
DB_PORT=3306
DB_NAME=marketplace_digital
DB_USER=mentoring
DB_PASSWORD=ganti-dengan-password-acak

# Wajib minimal 32 karakter. Server menolak start jika masih memakai nilai contoh ini.
JWT_SECRET=ganti-dengan-secret-lokal-yang-panjang
JWT_EXPIRES_IN=1d
