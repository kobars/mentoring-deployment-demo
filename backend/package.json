{
  "name": "mentoring-demo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Product API (Express + MySQL + JWT) untuk demo deploy ke VPS.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:check": "node scripts/check-db.js",
    "docs:check": "node scripts/check-docs.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm run docs:check && npm test",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "7.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "9.0.2",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0"
  }
}
