{
  "openapi": "3.0.3",
  "info": {
    "title": "Product API — Mentoring Deploy Demo",
    "version": "1.0.0",
    "description": "Demo deploy ke Vercel dan VPS: Express + MySQL + JWT. Register → login → salin data.token ke Authorize (token saja, tanpa prefix Bearer) → CRUD. Semua endpoint produk membutuhkan JWT; produk dibagikan antar akun, tanpa ownership per user. Auth mengembalikan success + data, produk mengembalikan data, dan error mengembalikan success:false + message + errors. DELETE 204 tidak memiliki body. Spesifikasi ini mengikuti implementasi; bukan generator route."
  },
  "servers": [
    {
      "url": "/api",
      "description": "Server API yang sama dengan Swagger UI"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Registrasi dan login tanpa Bearer token."
    },
    {
      "name": "Products",
      "description": "CRUD dan pencarian produk dengan Bearer JWT."
    },
    {
      "name": "System",
      "description": "Pemeriksaan server. /health hanya memeriksa proses; /health/ready juga memeriksa database."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Cek server",
        "description": "Tidak membutuhkan autentikasi. Status ok menunjukkan proses HTTP berjalan, bukan kesehatan database.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Server berjalan.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "security": [],
        "servers": [
          {
            "url": "/"
          }
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "Daftar akun",
        "description": "Password di-hash dengan bcrypt dan tidak dikembalikan. Email harus unik. Registrasi tidak menerbitkan token; lanjutkan ke login.",
        "tags": [
          "Auth"
        ],
        "responses": {
          "201": {
            "description": "Akun dibuat.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "user": {
                      "id": 1,
                      "name": "Budi",
                      "email": "budi@mail.com"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Body, parameter, atau ID tidak valid; JSON rusak juga menghasilkan 400.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Validasi gagal.",
                  "errors": [
                    {
                      "field": "email",
                      "message": "Format email tidak valid."
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Email sudah terdaftar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Email sudah digunakan.",
                  "errors": [
                    {
                      "field": "email",
                      "message": "Gunakan email lain atau login."
                    }
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Body JSON melebihi batas 100kb.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Body request terlalu besar.",
                  "errors": []
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "description": "Kesalahan tidak terduga, misalnya database tidak tersedia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Terjadi kesalahan pada server.",
                  "errors": []
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              },
              "example": {
                "name": "Budi",
                "email": "budi@mail.com",
                "password": "rahasia123"
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Login dan ambil JWT",
        "description": "Simpan data.token sebagai environment token di Postman. Credential salah yang lolos validasi menghasilkan 401. Tidak ada cookie sesi.",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Login berhasil.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "token": "<JWT hasil login>",
                    "tokenType": "Bearer",
                    "user": {
                      "id": 1,
                      "name": "Budi",
                      "email": "budi@mail.com"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Body, parameter, atau ID tidak valid; JSON rusak juga menghasilkan 400.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Validasi gagal.",
                  "errors": [
                    {
                      "field": "password",
                      "message": "Password minimal 8 karakter."
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Email tidak terdaftar atau password salah.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Email atau password salah.",
                  "errors": []
                }
              }
            }
          },
          "413": {
            "description": "Body JSON melebihi batas 100kb.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Body request terlalu besar.",
                  "errors": []
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "description": "Kesalahan tidak terduga, misalnya database tidak tersedia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Terjadi kesalahan pada server.",
                  "errors": []
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              },
              "example": {
                "email": "budi@mail.com",
                "password": "rahasia123"
              }
            }
          }
        }
      }
