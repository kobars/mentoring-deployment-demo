    "/health/ready": {
      "get": {
        "operationId": "healthReady",
        "summary": "Cek server dan database",
        "description": "Tidak membutuhkan autentikasi. Menjalankan SELECT 1 ke database. Dipakai setelah deploy untuk memastikan environment variable database sudah benar.",
        "tags": [
          "System"
        ],
        "security": [],
        "servers": [
          {
            "url": "/"
          }
        ],
        "responses": {
          "200": {
            "description": "Server dan database siap.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "database": "ok"
                }
              }
            }
          },
          "503": {
            "description": "Database tidak dapat dihubungi.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "unreachable"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "error",
                  "database": "unreachable"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT dari data.token pada response login. Signature dan expiry diverifikasi; sub berisi user ID. Tidak ada endpoint refresh/logout; logout client menghapus token lokal."
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "price",
          "description"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "description": "Angka JSON dari DECIMAL(12,2); database menyimpan dua angka desimal."
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ProductInput": {
        "type": "object",
        "required": [
          "name",
          "price",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Di-trim sebelum validasi panjang."
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "description": "Harus angka JSON, bukan string. Database DECIMAL(12,2) membatasi penyimpanan; nilai di luar kapasitas database belum dinormalisasi menjadi validation error."
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "description": "Wajib dikirim; string kosong diperbolehkan."
          }
        }
      },
      "PricePatch": {
        "type": "object",
        "required": [
          "price"
        ],
        "properties": {
          "price": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "RegisterInput": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Di-trim sebelum validasi."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Di-trim dan diubah menjadi lowercase."
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "writeOnly": true,
            "description": "Maksimal 72 byte UTF-8; tidak di-trim."
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Di-trim dan diubah menjadi lowercase."
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "writeOnly": true,
            "description": "Maksimal 72 byte UTF-8; tidak di-trim. Password terlalu pendek menghasilkan 400 sebelum pengecekan credential."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "success",
          "message",
          "errors"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Nama field; dapat kosong untuk validasi seluruh body."
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ProductResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "ProductListResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object",
            "required": [
              "user"
            ],
            "properties": {
              "user": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object",
            "required": [
              "token",
              "tokenType",
              "user"
            ],
            "properties": {
              "token": {
                "type": "string"
              },
              "tokenType": {
                "type": "string",
                "enum": [
                  "Bearer"
                ]
              },
              "user": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        }
      }
    },
    "responses": {
      "TooManyRequests": {
        "description": "Rate limit login/register terlampaui: 20 percobaan per 15 menit untuk setiap email.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "message": "Terlalu banyak percobaan. Coba lagi dalam 15 menit.",
              "errors": []
            }
          }
        }
      }
    }
  }
}
